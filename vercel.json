{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "cleanUrls": true,
    "trailingSlash": true,
    "redirects": [
        { "source": "/types", "destination": "/types/latest/", "permanent": false },
        { "source": "/types/", "destination": "/types/latest/", "permanent": false }
    ]
}